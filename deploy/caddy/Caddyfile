{
	# Let's Encrypt contact; unused when SITE_ADDRESS is a plain port.
	email {$ACME_EMAIL:admin@example.com}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Web simulator: its own host name (sim.<dashboard host>) and login.
{$SIM_SITE_ADDRESS::81} {
	encode zstd gzip
	import security_headers
	reverse_proxy simulator-ui:8000
}

{$SITE_ADDRESS::80} {
	encode zstd gzip
	import security_headers

	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		# Hashed assets are immutable; the app shell must never be cached, so "Back" after
		# signing out reloads it and lands on the login page.
		@shell not path /assets/*
		header @shell Cache-Control "no-store"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
