# Secrets kept in GCP Secret Manager (never in files on your laptop or in git).
# scripts/deploy.sh creates missing ones; deploy/fetch-secrets.sh reads them on the VM.
#
# ENV variable            Secret Manager name              flags
DB_PASSWORD               plc-db-password
JWT_SECRET                plc-jwt-secret
MQTT_ADMIN_PASSWORD       plc-mqtt-admin-password
MQTT_DB_PASSWORD          plc-mqtt-db-password
INGESTOR_MQTT_PASSWORD    plc-ingestor-mqtt-password
SIMULATOR_MQTT_PASSWORD   plc-simulator-mqtt-password
# Only used to create the very first dashboard admin on a new installation.
ADMIN_PASSWORD            plc-initial-admin-password       optional
