{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plc-dashboard.local/schemas/telemetry.v1.json",
  "title": "PLC telemetry message (v1)",
  "description": "Published by a PLC to plc/{site}/{line}/{device_id}/telemetry with QoS 1.",
  "type": "object",
  "required": ["schema_version", "device_id", "tags"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Source timestamp, RFC 3339. Server receive time is used when missing or skewed by more than 5 minutes."
    },
    "seq": { "type": "integer", "minimum": 0, "description": "Monotonic message counter." },
    "status": { "enum": ["RUN", "IDLE", "STOP", "FAULT", "MAINT"] },
    "tags": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 500,
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "type": "boolean" },
          { "type": "string", "maxLength": 256 }
        ]
      }
    },
    "quality": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
      "additionalProperties": { "enum": ["GOOD", "UNCERTAIN", "BAD"] }
    }
  }
}
