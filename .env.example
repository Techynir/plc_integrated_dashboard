# Copy to .env for local development. Production values are generated by scripts/deploy.sh.

# First admin user (created on first start only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Optional operator account (created once if set)
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# Secrets — change for anything reachable from the network
DB_PASSWORD=plc-dev-password
MQTT_ADMIN_PASSWORD=dev-mqtt-admin-password
MQTT_DB_PASSWORD=dev-mqtt-db-password
INGESTOR_MQTT_PASSWORD=dev-ingestor-password
JWT_SECRET=dev-insecure-jwt-secret

# Web: ":80" = plain HTTP. On GCP set a hostname (e.g. 34-100-10-20.sslip.io) for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
COOKIE_SECURE=false

# Host name PLCs use to reach the broker (goes into the TLS certificate).
MQTT_PUBLIC_HOST=localhost
MQTT_EXTRA_SANS=

# Web simulator (http://localhost:8081). On GCP: SIM_SITE_ADDRESS=sim.<SITE_ADDRESS>
SIMULATOR_MQTT_PASSWORD=dev-simulator-password
SIM_SITE_ADDRESS=:81
SIM_DEVICE_TTL_MIN=30
DASHBOARD_URL=http://localhost:8080
SIMULATOR_URL=http://localhost:8081
